<IfModule mod_rewrite.c>
RewriteEngine On

# API routes
RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]

# Serve existing files
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback — do NOT cache HTML via Expires; handled below
RewriteRule ^ index.html [L]

</IfModule>

Options -MultiViews
Options -Indexes

# Efficient cache lifetimes — Est savings 1,334 KiB
# Hashed Vite assets (assets/*) are immutable; HTML is short-lived
<IfModule mod_expires.c>
ExpiresActive On
# HTML: no long cache — always revalidate (SPA entry)
ExpiresByType text/html "access plus 0 seconds"
# Hashed assets: 1 year immutable
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType application/json "access plus 1 year"
# Fonts: 1 year
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/woff "access plus 1 year"
ExpiresByType font/ttf "access plus 1 year"
ExpiresByType font/otf "access plus 1 year"
ExpiresByType application/font-woff2 "access plus 1 year"
# Images: 1 year (revalidated via content hash where possible)
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
# SEO files: short cache so crawlers pick updates quickly
ExpiresByType text/plain "access plus 1 hour"
ExpiresByType application/xml "access plus 1 hour"
ExpiresByType text/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
# HTML: prevent stale SPA shell
<FilesMatch "index\.html$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
# robots.txt / sitemap.xml: revalidate hourly (SEO freshness)
<FilesMatch "^(robots\.txt|sitemap\.xml)$">
Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>
# Hashed assets: immutable long cache (Vite emits /assets/* with content hash)
<FilesMatch "\.(js|css|woff2?|ttf|otf|webp|avif|png|jpe?g|svg|ico)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# Security + 3rd parties
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression — reduces image delivery + CSS/JS transfer (Est savings 747 KiB + 48 KiB + 31 KiB)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml font/woff2
</IfModule>

# Pre-compressed Brotli / Gzip (if generated at build: .br / .gz alongside assets)
<IfModule mod_brotli.c>
AddType text/html .html
</IfModule>
